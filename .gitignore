# La base est reconstructible : le dépôt versionne la méthode et le
# référentiel, pas les données dérivées.
data/*.duckdb
data/*.duckdb.wal
data/*.sqlite
data/journal/

# Le cache brut : ce que Hub'Eau a répondu, tel quel (src/brut.py). Non
# versionné — un département pèse ~80 Mo — mais c'est le SEUL objet du dépôt
# qu'on ne peut pas refabriquer tout seul, puisque le refabriquer voudrait dire
# redemander des milliers de bulletins à un service public gratuit (§3.2).
# À conserver et à sauvegarder hors git.
data/brut/

# Le journal des abandons et les autres matériaux d'étude : entièrement
# dérivés de la base, régénérés par src/etude_panel.py.
# Les MATERIAUX d'etude (gros CSV generes) restent dehors...
data/etudes/*
# ...mais PAS les dossiers REDIGES, qui sont du travail editorial et la piece
# justificative de ce que le site affiche. Corrige le 12 aout 2026 : ils
# etaient exclus avec le reste, donc jamais versionnes.
!data/etudes/sourcage_C/
!data/etudes/conformite_sur_panel_reduit/
# Les REPONSES aux demandes exterieures : elles nomment une commune, elles
# sortent du projet et elles engagent sa signature. Un document remis a un
# tiers doit etre date, retrouvable et opposable a ce qu'on en fera ensuite.
!data/etudes/demandes/
# ...mais pas les PDF qui en sortent : ils se regenerent du Markdown, qui reste
# le document de reference (sortie/topo_pdf.py). Ne jamais corriger dans le PDF.
data/etudes/demandes/*.pdf
data/etudes/demandes/_apercu.html
# Les PDF se regenerent depuis le Markdown (src/md_en_pdf.py).
data/etudes/conformite_sur_panel_reduit/pdf/

# Copies de sauvegarde : inutiles des lors que git tient l'historique.
*.bak
*.bak-*

# Les dossiers de faits envoyés en rédaction, et les réponses en attente
# d'intégration. Entièrement dérivés de la base, refabriqués par
# sortie/rediger_lot.py --dossiers ; ce qui compte finit dans
# sortie/redactions_proposees.json, qui est versionné.
data/dossiers/

# Sorties générées
sortie/*.html
!sortie/_template.html
sortie/*.pdf

# La vitrine est entièrement dérivée de la base et des gabarits : c'est un
# produit, pas une source. On versionne site/gabarits/, jamais site/public/.
#
# Nuance assumée : versionner le site publié donnerait l'historique de ce qui a
# été affiché, ce qui a du sens pour un projet dont le sujet est le déplacement
# des seuils. Mais cet historique existe déjà, mieux placé — dans les lignes
# figées, qui portent leur version de référentiel et leur date de calcul.
site/public/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Système
.DS_Store
Thumbs.db
*~

# Les sources externes téléchargées (data.gouv.fr) : publiques, re-téléchargeables,
# et volumineuses — un mois de prélèvements pèse 16 Mo compressés. Les URL et
# les empreintes sont consignées dans docs/REPRISE.md §20.8 et §20.10.
data/sources_externes/

# Les PDF se régénèrent depuis le Markdown (src/md_en_pdf.py).
docs/pdf/
